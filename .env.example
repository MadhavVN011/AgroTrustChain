# Copy to .env to override the Docker defaults. Everything here is optional.

# SQL Server "sa" password. Must be 8+ chars with 3 of: upper, lower, digit, symbol.
# Change it before the first `docker compose up`: it is baked into the database volume.
MSSQL_SA_PASSWORD=AgroTrust_Dev_2026!

# Signs the login session cookie. If empty, a random key is generated at each
# start (everyone is logged out when the app restarts).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Host ports (bound to 127.0.0.1 only). Change if something already uses them,
# e.g. Ganache GUI on 7545 or macOS AirPlay on 5000.
APP_PORT=5000
DB_PORT=1433
GANACHE_PORT=7545
